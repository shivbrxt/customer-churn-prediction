        </div>
        """, unsafe_allow_html=True)

    else:
        input_df = pd.DataFrame([{
            "gender":           gender,
            "SeniorCitizen":    1 if senior == "Yes" else 0,
            "Partner":          partner,
            "Dependents":       dependents,
            "tenure":           tenure,
            "PhoneService":     phone_svc,
            "MultipleLines":    multi_lines,
            "InternetService":  internet,
            "OnlineSecurity":   online_sec,
            "OnlineBackup":     online_bkp,
            "DeviceProtection": device_prot,
            "TechSupport":      tech_supp,
            "StreamingTV":      stream_tv,
            "StreamingMovies":  stream_movies,
            "Contract":         contract,
            "PaperlessBilling": paperless,
            "PaymentMethod":    payment,
            "MonthlyCharges":   monthly,
            "TotalCharges":     total,
        }])

        prob  = model.predict_proba(input_df)[0, 1]
        churn = prob >= THRESHOLD
        pct   = round(prob * 100, 1)
        stay  = round(100 - pct, 1)

        if pct < 30:   badge_cls, risk_label, dot = "risk-low",  "Low Risk",    "🟢"
        elif pct < 55: badge_cls, risk_label, dot = "risk-med",  "Medium Risk", "🟡"
        else:          badge_cls, risk_label, dot = "risk-high", "High Risk",   "🔴"

        card_cls   = "result-churn" if churn else "result-stay"
        verdict    = "Will Churn"   if churn else "Will Stay"
        verdict_sub = ("Customer is likely to cancel their subscription."
                       if churn else "Customer is likely to remain active.")
        fill_cls   = "pbar-fill-churn" if churn else "pbar-fill-stay"

        # Retention tip
        if churn:
